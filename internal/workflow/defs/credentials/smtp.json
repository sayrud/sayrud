{
  "type": "smtp",
  "label": "workflow.credential.smtp.title",
  "description": "workflow.credential.smtp.description",
  "icon": "mail",
  "summary": ["fromAddress", "host"],
  "sections": [
    {
      "title": "workflow.credential.smtp.server",
      "fields": [
        { "key": "host", "widget": "text", "label": "workflow.credential.smtp.host", "required": true, "placeholder": "smtp.example.com", "maxLength": 255 },
        { "key": "port", "widget": "number", "label": "workflow.credential.smtp.port", "required": true, "default": 465, "min": 1, "max": 65535 },
        {
          "key": "security",
          "widget": "select",
          "display": "radio",
          "label": "workflow.credential.smtp.security",
          "required": true,
          "default": "tls",
          "options": [
            { "value": "tls", "label": "workflow.credential.smtp.securityTls", "patch": { "port": 465 } },
            { "value": "starttls", "label": "workflow.credential.smtp.securityStartTls", "patch": { "port": 587 } },
            { "value": "none", "label": "workflow.credential.smtp.securityNone", "patch": { "port": 25 } }
          ]
        },
        { "key": "username", "widget": "text", "label": "workflow.credential.smtp.username", "maxLength": 255 },
        { "key": "password", "widget": "password", "label": "workflow.credential.smtp.password", "secret": true, "maxLength": 255 }
      ]
    },
    {
      "title": "workflow.credential.smtp.sender",
      "fields": [
        { "key": "fromAddress", "widget": "email", "label": "workflow.credential.smtp.fromAddress", "required": true, "placeholder": "noreply@example.com", "maxLength": 255 },
        { "key": "fromName", "widget": "text", "label": "workflow.credential.smtp.fromName", "help": "workflow.credential.smtp.fromNameDescription", "maxLength": 255 }
      ]
    }
  ],
  "test": {
    "description": "workflow.credential.smtp.testDescription",
    "action": "workflow.credential.smtp.testSend",
    "success": "workflow.credential.smtp.testSuccess",
    "fields": [{ "key": "to", "widget": "email", "label": "workflow.credential.smtp.testTo", "required": true, "placeholder": "you@example.com" }]
  }
}
